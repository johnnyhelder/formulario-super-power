# Form Dinâmico: variáveis de ambiente
# Copie para .env.local (uso local) e cadastre as MESMAS na Vercel (Settings > Environment Variables).
# .env.local está no .gitignore. Nunca coloque valores reais neste arquivo nem em nenhum outro que vá para o git.
# Para gravar uma chave sem ela aparecer na tela: npm run chave -- NOME_DA_VARIAVEL

# --- IA (platform.claude.com > API Keys). Sem ela, o formulário funciona sem os extras de IA. ---
ANTHROPIC_API_KEY=
# Só se a chave não estiver presa a um workspace (o `npm run chave` pergunta quando precisa).
ANTHROPIC_WORKSPACE_ID=

# --- Pesquisa da empresa na internet (firecrawl.dev > API Keys, ~2 créditos por pesquisa). Opcional. ---
FIRECRAWL_API_KEY=

# --- Banco (Neon, plano grátis: Dashboard > Connect). Grava cada conversa, inclusive as abandonadas. ---
DATABASE_URL=

# --- Aviso por e-mail quando chega um lead (resend.com, plano grátis) ---
RESEND_API_KEY=
# Quem recebe (pode ser mais de um, separados por vírgula).
AVISO_PARA=
# Quem envia. Tem de ser de um domínio verificado no Resend, ex. Formulário <form@seudominio.com>.
# Vazio = onboarding@resend.dev, que só entrega ao e-mail dono da conta Resend.
AVISO_DE=

# Pedidos abertos com ?teste=1 vão para este e-mail (vazio = AVISO_PARA), com [TESTE] no assunto.
AVISO_TESTE_PARA=

# --- Avisos extra (opcionais). Pedidos de teste não vão para estes. ---
# Telegram: crie um bot no @BotFather e mande-lhe uma mensagem; o chat id vem em https://api.telegram.org/bot<TOKEN>/getUpdates
AVISO_TELEGRAM_TOKEN=
AVISO_TELEGRAM_CHAT=
# Recebe cada lead em JSON (n8n, Make, Zapier, CRM).
AVISO_WEBHOOK_URL=

# --- Travão de gasto ---
# Máximo de chamadas à IA por dia, no site inteiro (precisa de DATABASE_URL). Padrão 1500 (~150 a 250 conversas).
IA_TETO_DIARIO=

# --- Anti-robô (Cloudflare Turnstile, grátis). Opcional, recomendado para anúncios. ---
# dash.cloudflare.com > Turnstile > Add widget (domínio do formulário, modo "Managed").
# Com as duas preenchidas, a IA só responde a quem passou pela Cloudflare.
# Chaves de teste públicas da Cloudflare (sempre passam): 1x00000000000000000000AA e 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Opcional: segredo próprio para assinar a sessão (vazio = usa TURNSTILE_SECRET_KEY).
SESSAO_SEGREDO=
